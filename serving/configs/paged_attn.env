# For experiment 03: paged attention + KV cache behavior under load.
# Prefix caching reuses KV blocks across requests that share a prompt prefix.
# Run once WITH and once WITHOUT --enable-prefix-caching and compare TTFT.
MODEL="Qwen/Qwen2.5-7B-Instruct"
TP=2
DTYPE="float16"
GPU_MEM_UTIL="0.90"
MAX_MODEL_LEN="8192"
PORT="8000"
EXTRA_ARGS="--enable-prefix-caching"
# To see the KV cache SATURATE, lower GPU_MEM_UTIL (e.g. 0.55) so fewer KV
# blocks exist, then push concurrency up until vLLM starts preempting requests.
