# A small Mixture-of-Experts model with EXPERT parallelism enabled.
# OLMoE-1B-7B = 7B total params, ~1B active — fits comfortably on 2×T4.
# (Alternatives: Qwen/Qwen1.5-MoE-A2.7B-Chat, allenai/OLMoE-1B-7B-0924-Instruct)
MODEL="allenai/OLMoE-1B-7B-0924-Instruct"
TP=2
DTYPE="float16"
GPU_MEM_UTIL="0.90"
MAX_MODEL_LEN="4096"
PORT="8000"
# --enable-expert-parallel routes experts across GPUs instead of sharding every
# layer with TP. This is the knob for experiments 02 (EP) and 04 (TP+EP hybrid).
EXTRA_ARGS="--enable-expert-parallel"
