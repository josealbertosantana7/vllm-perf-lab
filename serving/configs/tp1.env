# Baseline: a dense 7B model on a SINGLE T4.
# Compare against tp2.env to measure the tensor-parallelism speedup.
MODEL="Qwen/Qwen2.5-7B-Instruct"
TP=1
DTYPE="float16"
GPU_MEM_UTIL="0.90"
MAX_MODEL_LEN="8192"
PORT="8000"
# Pin to one GPU so the comparison is fair:
# (set before launch)  export CUDA_VISIBLE_DEVICES=0
